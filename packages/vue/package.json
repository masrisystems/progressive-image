{
  "name": "@masrisystems/progressive-image-vue",
  "version": "0.1.0",
  "description": "Progressive image component for Vue 3: blur-up LQIP placeholder, cached-image reconciliation, CDN-to-origin retry, and an accessible error state. Framework CSS not required.",
  "keywords": [
    "vue",
    "vue3",
    "image",
    "progressive",
    "lazy-loading",
    "lqip",
    "blur-up",
    "placeholder",
    "performance",
    "core-web-vitals"
  ],
  "license": "MIT",
  "author": "Masri Systems",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/progressive-image-vue.js",
  "module": "./dist/progressive-image-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/progressive-image-vue.js"
    },
    "./src/ProgressiveImage.vue": "./src/ProgressiveImage.vue",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "dist/progressive-image-vue.js",
    "*.vue"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masrisystems/progressive-image.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
